# NextOmni Stock (nextomni-stock) Environment Configuration

# Database Configuration
NEXTOMNI_STOCK_DB_PATH=data/stock_system.db

# Market Data Providers
# Twelve Data API Key (Optional / Fallback, register at https://twelvedata.com)
NEXTOMNI_STOCK_TWELVE_DATA_API_KEY=

# Application Environment (development, staging, production)
NEXTOMNI_STOCK_ENV=development
NEXTOMNI_STOCK_LOG_LEVEL=INFO

